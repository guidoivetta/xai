\begin{frame}{Achieving Model Understanding}
\protect\hypertarget{achieving-model-understanding-1}{}
\begin{block}{Take 2: Explain pre-built models in a post-hoc manner}
\protect\hypertarget{take-2-explain-pre-built-models-in-a-post-hoc-manner}{}
Black Box Model → \textbf{Explainer} → Human-interpretable explanation

\emph{{[}Ribeiro et. al.~2016, 2018; Lakkaraju et. al.~2019{]}}
\end{block}
\end{frame}

\begin{frame}{Inherently Interpretable Models vs.~Post hoc Explanations}
\protect\hypertarget{inherently-interpretable-models-vs.-post-hoc-explanations}{}
\begin{block}{Accuracy-Interpretability Trade-offs}
\protect\hypertarget{accuracy-interpretability-trade-offs}{}
In certain settings, accuracy-interpretability trade offs may exist.

\textbf{Example scenarios:}

\begin{itemize}
\tightlist
\item
  Simple boundary: Can build interpretable + accurate models
\item
  Complex boundary: Complex models might achieve higher accuracy
\end{itemize}

\emph{{[}Cireşan et. al.~2012, Caruana et. al.~2006, Frosst et.
al.~2017, Stewart 2020{]}}
\end{block}
\end{frame}

\begin{frame}{Inherently Interpretable Models vs.~Post hoc Explanations}
\protect\hypertarget{inherently-interpretable-models-vs.-post-hoc-explanations-1}{}
\textbf{Sometimes, you don't have enough data to build your model from
scratch.}

\textbf{And, all you have is a (proprietary) black box!}

\emph{{[}Ribeiro et. al.~2016{]}}
\end{frame}

\begin{frame}{Inherently Interpretable Models vs.~Post hoc Explanations}
\protect\hypertarget{inherently-interpretable-models-vs.-post-hoc-explanations-2}{}
\begin{block}{Recommendation}
\protect\hypertarget{recommendation}{}
\textbf{If you can build an interpretable model which is also adequately
accurate for your setting, DO IT!}

\textbf{Otherwise, post hoc explanations come to the rescue!}
\end{block}
\end{frame}

\begin{frame}{Defining and Understanding Interpretability}
\protect\hypertarget{defining-and-understanding-interpretability}{}
\begin{block}{Motivation for Interpretability}
\protect\hypertarget{motivation-for-interpretability}{}
ML systems are being deployed in complex high-stakes settings:

\begin{itemize}
\tightlist
\item
  Accuracy alone is no longer enough
\item
  Auxiliary criteria are important:

  \begin{itemize}
  \tightlist
  \item
    Safety
  \item
    Nondiscrimination
  \item
    Right to explanation
  \end{itemize}
\end{itemize}
\end{block}
\end{frame}

\begin{frame}{Motivation for Interpretability (cont.)}
\protect\hypertarget{motivation-for-interpretability-cont.}{}
Auxiliary criteria are often hard to quantify (completely):

\begin{itemize}
\tightlist
\item
  E.g.: Impossible to enumerate all scenarios violating safety of an
  autonomous car
\end{itemize}

\textbf{Fallback option: interpretability}

\begin{itemize}
\tightlist
\item
  If the system can explain its reasoning, we can verify if that
  reasoning is sound w.r.t. auxiliary criteria
\end{itemize}
\end{frame}

\begin{frame}{Prior Work: Defining and Measuring Interpretability}
\protect\hypertarget{prior-work-defining-and-measuring-interpretability}{}
Little consensus on what interpretability is and how to evaluate it.

\textbf{Interpretability evaluation typically falls into:}

\begin{enumerate}
\item
  \textbf{Evaluate in the context of an application}

  \begin{itemize}
  \tightlist
  \item
    If a system is useful in a practical application or a simplified
    version, it must be interpretable
  \end{itemize}
\item
  \textbf{Evaluate via a quantifiable proxy}

  \begin{itemize}
  \tightlist
  \item
    Claim some model class is interpretable and present algorithms to
    optimize within that class
  \item
    E.g. rule lists
  \end{itemize}
\end{enumerate}

\textbf{``You will know it when you see it!''}
\end{frame}

\begin{frame}{Lack of Rigor?}
\protect\hypertarget{lack-of-rigor}{}
\textbf{Yes and No}

\begin{itemize}
\tightlist
\item
  Previous notions are reasonable
\item
  \textbf{However:}

  \begin{itemize}
  \tightlist
  \item
    Are all models in all ``interpretable'' model classes equally
    interpretable?
  \item
    Model sparsity allows for comparison
  \item
    How to compare a linear model with a decision tree?
  \item
    Do all applications have same interpretability needs?
  \end{itemize}
\end{itemize}

\textbf{Important to formalize these notions!!!}
\end{frame}

\begin{frame}{What is Interpretability?}
\protect\hypertarget{what-is-interpretability}{}
\textbf{Definition:} Ability to explain or to present in understandable
terms to a human

\textbf{No clear answers in psychology to:}

\begin{itemize}
\tightlist
\item
  What constitutes an explanation?
\item
  What makes some explanations better than the others?
\item
  When are explanations sought?
\end{itemize}
\end{frame}

\begin{frame}{When and Why Interpretability?}
\protect\hypertarget{when-and-why-interpretability}{}
\textbf{Not all ML systems require interpretability}

\begin{itemize}
\tightlist
\item
  E.g., ad servers, postal code sorting
\item
  No human intervention
\item
  \textbf{No explanation needed because:}

  \begin{itemize}
  \tightlist
  \item
    No consequences for unacceptable results
  \item
    Problem is well studied and validated well in real-world
    applications → trust system's decision
  \end{itemize}
\end{itemize}

\textbf{When do we need explanation then?}
\end{frame}

\begin{frame}{When and Why Interpretability?}
\protect\hypertarget{when-and-why-interpretability-1}{}
\begin{block}{Incompleteness in problem formalization}
\protect\hypertarget{incompleteness-in-problem-formalization}{}
\begin{itemize}
\tightlist
\item
  Hinders optimization and evaluation
\item
  \textbf{Incompleteness \(\neq\) Uncertainty}
\item
  Uncertainty can be quantified
\item
  E.g., trying to learn from a small dataset (uncertainty)
\end{itemize}
\end{block}
\end{frame}

\begin{frame}{Incompleteness: Illustrative Examples}
\protect\hypertarget{incompleteness-illustrative-examples}{}
\textbf{Scientific Knowledge}

\begin{itemize}
\tightlist
\item
  E.g., understanding the characteristics of a large dataset
\item
  Goal is abstract
\end{itemize}

\textbf{Safety}

\begin{itemize}
\tightlist
\item
  End to end system is never completely testable
\item
  Not possible to check all possible inputs
\end{itemize}

\textbf{Ethics}

\begin{itemize}
\tightlist
\item
  Guard against certain kinds of discrimination which are too abstract
  to be encoded
\item
  No idea about the nature of discrimination beforehand
\end{itemize}
\end{frame}

\begin{frame}{Taxonomy of Interpretability Evaluation}
\protect\hypertarget{taxonomy-of-interpretability-evaluation}{}
\begin{longtable}[]{@{}lll@{}}
\toprule
& \textbf{Humans} & \textbf{Tasks}\tabularnewline
\midrule
\endhead
\textbf{Application-grounded Evaluation} & Real Humans & Real
Tasks\tabularnewline
\textbf{Human-grounded Evaluation} & Real Humans & Simple
Tasks\tabularnewline
\textbf{Functionally-grounded Evaluation} & No Real Humans & Proxy
Tasks\tabularnewline
\bottomrule
\end{longtable}

\textbf{Claim of the research should match the type of the evaluation!}
\end{frame}

\begin{frame}{Application-grounded evaluation}
\protect\hypertarget{application-grounded-evaluation}{}
\textbf{Real humans (domain experts), real tasks}

\begin{itemize}
\tightlist
\item
  Domain experts experiment with exact application task
\item
  Domain experts experiment with a simpler or partial task

  \begin{itemize}
  \tightlist
  \item
    Shorten experiment time
  \item
    Increases number of potential subjects
  \end{itemize}
\item
  Typical in HCI and visualization communities
\end{itemize}
\end{frame}

\begin{frame}{Human-grounded evaluation}
\protect\hypertarget{human-grounded-evaluation}{}
\textbf{Real humans, simplified tasks}

\begin{itemize}
\tightlist
\item
  Can be completed with lay humans
\item
  Larger pool, less expensive
\end{itemize}

\textbf{Potential experiments:}

\begin{itemize}
\tightlist
\item
  Pairwise comparisons
\item
  Simulate the model output
\item
  What changes should be made to input to change the output?
\end{itemize}
\end{frame}

\begin{frame}{Functionally-grounded evaluation}
\protect\hypertarget{functionally-grounded-evaluation}{}
\textbf{No humans, just proxies}

\textbf{Appropriate for:}

\begin{itemize}
\tightlist
\item
  A class of models already validated (E.g., decision trees)
\item
  A method is not yet mature
\item
  Human subject experiments are unethical
\end{itemize}

\textbf{What proxies to use?}

\textbf{Potential experiments:}

\begin{itemize}
\tightlist
\item
  Complexity (of a decision tree) compared to other models of the same
  (similar) class
\item
  How many levels? How many rules?
\end{itemize}
\end{frame}

\begin{frame}{Open Problems: Design Issues}
\protect\hypertarget{open-problems-design-issues}{}
\begin{itemize}
\tightlist
\item
  What proxies are best for what real world applications?
\item
  What factors to consider when designing simpler tasks in place of real
  world tasks?
\end{itemize}
\end{frame}

\begin{frame}{Taxonomy based on applications/tasks}
\protect\hypertarget{taxonomy-based-on-applicationstasks}{}
\textbf{Global vs.~Local}

\begin{itemize}
\tightlist
\item
  High level patterns vs.~specific decisions
\end{itemize}

\textbf{Degree of Incompleteness}

\begin{itemize}
\tightlist
\item
  What part of the problem is incomplete? How incomplete is it?
\item
  Incomplete inputs or constraints or costs?
\end{itemize}

\textbf{Time Constraints}

\begin{itemize}
\tightlist
\item
  How much time can the user spend to understand explanation?
\end{itemize}
\end{frame}

\begin{frame}{Taxonomy based on applications/tasks (cont.)}
\protect\hypertarget{taxonomy-based-on-applicationstasks-cont.}{}
\textbf{Nature of User Expertise}

\begin{itemize}
\tightlist
\item
  How experienced is end user?
\item
  Experience affects how users process information
\item
  E.g., domain experts can handle detailed, complex explanations
  compared to opaque, smaller ones
\end{itemize}

\textbf{Note:} These taxonomies are constructed based on intuition and
are not data or evidence driven. They must be treated as hypotheses.
\end{frame}

\begin{frame}{Taxonomy based on methods}
\protect\hypertarget{taxonomy-based-on-methods}{}
\textbf{Basic units of explanation:}

\begin{itemize}
\tightlist
\item
  Raw features? E.g., pixel values
\item
  Semantically meaningful? E.g., objects in an image
\item
  Prototypes?
\end{itemize}

\textbf{Number of basic units of explanation:}

\begin{itemize}
\tightlist
\item
  How many does the explanation contain?
\item
  How do various types of basic units interact?
\item
  E.g., prototype vs.~feature
\end{itemize}
\end{frame}

\begin{frame}{Taxonomy based on methods (cont.)}
\protect\hypertarget{taxonomy-based-on-methods-cont.}{}
\textbf{Level of compositionality:}

\begin{itemize}
\tightlist
\item
  Are the basic units organized in a structured way?
\item
  How do the basic units compose to form higher order units?
\end{itemize}

\textbf{Interactions between basic units:}

\begin{itemize}
\tightlist
\item
  Combined in linear or non-linear ways?
\item
  Are some combinations easier to understand?
\end{itemize}

\textbf{Uncertainty:}

\begin{itemize}
\tightlist
\item
  What kind of uncertainty is captured by the methods?
\item
  How easy is it for humans to process uncertainty?
\end{itemize}
\end{frame}

\begin{frame}{Relevant Conferences to Explore}
\protect\hypertarget{relevant-conferences-to-explore}{}
\textbf{ML/AI Venues:}

\begin{itemize}
\tightlist
\item
  ICML, NeurIPS, ICLR
\item
  UAI, AISTATS, KDD, AAAI
\end{itemize}

\textbf{Ethics/HCI Venues:}

\begin{itemize}
\tightlist
\item
  FAccT, AIES
\item
  CHI, CSCW, HCOMP
\end{itemize}
\end{frame}

\begin{frame}{Breakout Groups}
\protect\hypertarget{breakout-groups}{}
\textbf{Say hi to your neighbors! Introduce yourselves!}

\begin{itemize}
\tightlist
